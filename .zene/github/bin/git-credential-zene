#!/bin/sh
if [ "$1" != "get" ]; then exit 0; fi
while IFS= read -r line || [ -n "$line" ]; do
[ -z "$line" ] && break
done
TOKEN=$(cat '/Users/xinference/github/zene/cloud/data/workspaces/ws/f4cb14bf-217d-42da-b72e-bd795a539944/.zene/github/token')
[ -n "$TOKEN" ] || exit 1
printf 'username=x-access-token\npassword=%s\n' "$TOKEN"
